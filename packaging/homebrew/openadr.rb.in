# Generated by packaging/homebrew/formula.sh for openadr @VERSION@; do not edit.
class Openadr < Formula
  desc "OpenADR 3.1 VTN, VEN client and open conformance suite in one binary"
  homepage "https://hupe1980.github.io/openadr/"
  license any_of: ["MIT", "Apache-2.0"]

  on_macos do
    on_arm do
      url "https://github.com/hupe1980/openadr/releases/download/v@VERSION@/openadr-v@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA256_aarch64-apple-darwin@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/hupe1980/openadr/releases/download/v@VERSION@/openadr-v@VERSION@-aarch64-unknown-linux-musl.tar.gz"
      sha256 "@SHA256_aarch64-unknown-linux-musl@"
    end
    on_intel do
      url "https://github.com/hupe1980/openadr/releases/download/v@VERSION@/openadr-v@VERSION@-x86_64-unknown-linux-musl.tar.gz"
      sha256 "@SHA256_x86_64-unknown-linux-musl@"
    end
  end

  def install
    bin.install "openadr"
  end

  def caveats
    <<~EOS
      A VTN with seeded programmes, two clients and the inspector, in one command:
        openadr dev
    EOS
  end

  test do
    assert_match "openadr #{version}", shell_output("#{bin}/openadr version")
  end
end
